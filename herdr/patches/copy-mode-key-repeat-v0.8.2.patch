+impl App {
+    /// Record a key press for held-key repeat gating.
+    ///
+    /// Repeats are only replayed in the mode that saw the original press:
+    /// terminal mode (so shells get continuous input) and copy mode (so
+    /// `ctrl+d`/`ctrl+u`/`j`/`k` can be held to scroll). Repeats of keys
+    /// pressed in any other mode are dropped so that modal close/confirm
+    /// keys never leak into the shell.
+    pub(crate) fn note_repeat_press(
+        &mut self,
+        key_id: (crossterm::event::KeyCode, crossterm::event::KeyModifiers),
+    ) {
+        match self.state.mode {
+            Mode::Terminal => {
+                self.suppressed_repeat_keys.remove(&key_id);
+                self.copy_mode_repeat_keys.remove(&key_id);
+            }
+            Mode::Copy => {
+                self.suppressed_repeat_keys.insert(key_id);
+                self.copy_mode_repeat_keys.insert(key_id);
+            }
+            _ => {
+                self.suppressed_repeat_keys.insert(key_id);
+                self.copy_mode_repeat_keys.remove(&key_id);
+            }
+        }
+    }
+
+    pub(crate) fn should_handle_repeat(
+        &self,
+        key_id: &(crossterm::event::KeyCode, crossterm::event::KeyModifiers),
+    ) -> bool {
+        match self.state.mode {
+            Mode::Terminal => !self.suppressed_repeat_keys.contains(key_id),
+            Mode::Copy => self.copy_mode_repeat_keys.contains(key_id),
+            _ => false,
+        }
+    }
+
+    pub(crate) fn note_repeat_release(
+        &mut self,
+        key_id: &(crossterm::event::KeyCode, crossterm::event::KeyModifiers),
+    ) {
+        self.suppressed_repeat_keys.remove(key_id);
+        self.copy_mode_repeat_keys.remove(key_id);
+    }
+}
+
 fn auto_updates_enabled(_no_session: bool) -> bool {
