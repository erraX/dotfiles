      "after": [
        "5",
        "h"
      ]
    },
    {
      "before": [
        "<C-j>"
      ],
      "after": [
        "5",
        "g",
        "j"
      ]
    },
    {
      "before": [
        "<C-k>"
      ],
      "after": [
        "5",
        "g",
        "k"
      ]
    },
    {
      "before": [
        "<C-l>"
      ],
      "after": [
        "5",
        "l"
      ]
    },
    {
      "before": [
        "<space>"
      ],
      "commands": [
        "vspacecode.space"
      ]
    },
    {
      "before": [
        ","
      ],
      "commands": [
        "vspacecode.space",
        {
          "command": "whichkey.triggerKey",
          "args": "m"
        }
      ]
    }
  ],
