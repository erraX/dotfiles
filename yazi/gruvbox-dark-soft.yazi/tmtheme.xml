<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>name</key><string>Gruvbox Dark Soft (Yazi)</string>

    <key>settings</key>
    <array>
      <!-- Global -->
      <dict>
        <key>settings</key>
        <dict>
          <key>background</key><string>#32302f</string>
          <key>foreground</key><string>#ebdbb2</string>
          <key>caret</key><string>#ebdbb2</string>
          <key>selection</key><string>#504945</string>
          <key>lineHighlight</key><string>#3c3836</string>
        </dict>
      </dict>

      <!-- Comments -->
      <dict>
        <key>name</key><string>Comments</string>
        <key>scope</key><string>comment, punctuation.definition.comment</string>
        <key>settings</key>
        <dict>
          <key>fontStyle</key><string>italic</string>
          <key>foreground</key><string>#928374</string>
        </dict>
      </dict>

      <!-- Keywords -->
      <dict>
        <key>name</key><string>Keywords</string>
        <key>scope</key><string>keyword, storage</string>
        <key>settings</key>
        <dict>
          <key>foreground</key><string>#fb4934</string>
        </dict>
      </dict>

      <!-- Types / Variables -->
      <dict>
        <key>name</key><string>Types & Variables</string>
        <key>scope</key><string>storage.type, support.type, variable, support.variable</string>
        <key>settings</key>
        <dict>
          <key>foreground</key><string>#83a598</string>
        </dict>
      </dict>

      <!-- Strings -->
      <dict>
        <key>name</key><string>Strings</string>
        <key>scope</key><string>string</string>
        <key>settings</key>
        <dict>
          <key>foreground</key><string>#b8bb26</string>
        </dict>
      </dict>

      <!-- Numbers / Constants -->
      <dict>
        <key>name</key><string>Numbers & Constants</string>
        <key>scope</key><string>constant.numeric, constant.character, constant</string>
        <key>settings</key>
        <dict>
          <key>foreground</key><string>#d3869b</string>
        </dict>
      </dict>

      <!-- Functions -->
      <dict>
        <key>name</key><string>Functions</string>
        <key>scope</key><string>entity.name.function, support.function</string>
        <key>settings</key>
        <dict>
          <key>fontStyle</key><string>bold</string>
          <key>foreground</key><string>#b8bb26</string>
        </dict>
      </dict>

      <!-- Punctuation / Operators -->
      <dict>
        <key>name</key><string>Punctuation</string>
        <key>scope</key><string>punctuation, keyword.operator</string>
        <key>settings</key>
        <dict>
          <key>foreground</key><string>#a89984</string>
        </dict>
      </dict>

      <!-- Invalid -->
      <dict>
        <key>name</key><string>Invalid</string>
        <key>scope</key><string>invalid</string>
        <key>settings</key>
        <dict>
          <key>foreground</key><string>#fb4934</string>
        </dict>
      </dict>
